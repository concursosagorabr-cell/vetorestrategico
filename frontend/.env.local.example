# Vetor Estratégico - Frontend Environment Variables

# API & Site URLs
NEXT_PUBLIC_API_URL=http://localhost:8006
NEXT_PUBLIC_SITE_URL=https://vetorestrategico.com.br

# Database (Neon PostgreSQL Serverless)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Painel Administrativo de Leads (Obrigatório em Produção)
ADMIN_SECRET_KEY="sua_chave_secreta_aqui"

# Inteligência Artificial (Groq SDK)
GROQ_API_KEY="gsk_..."
GROQ_MODEL="openai/gpt-oss-120b"

# E-mail & Notificações (SMTP)
COMMERCIAL_EMAIL="contato.vetorestrategico@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="contato.vetorestrategico@gmail.com"
SMTP_PASSWORD="app_password"
SMTP_FROM_EMAIL="contato.vetorestrategico@gmail.com"
